# ==========================================
# Dependencies
# ==========================================
# Ignores node_modules at the root and in any subfolder
node_modules/
jspm_packages/
.pnp
.pnp.js

# ==========================================
# Electron & Build Outputs
# ==========================================
# Common build artifact directories generated by electron-builder, electron-packager, forge, etc.
dist/
out/
build/
bin/
release/
package/
*.app/

# Native build intermediate directories
build/Release/
build/Debug/
*.node

# TypeScript compilation output
tsconfig.tsbuildinfo

# ==========================================
# Logs & Runtime Data
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
# Environment Variables & Secrets
# ==========================================
# Never commit credentials or API keys
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# ==========================================
# OS-Specific Files
# ==========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini

# Linux
*~

# ==========================================
# IDE & Editor Configurations
# ==========================================
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
*.swp
*.swo